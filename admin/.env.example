# ─────────────────────────────────────────────────────────────
# Westcrest Media Admin — Environment Variables
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is gitignored and NEVER committed.
#
# Secret keys (SUPABASE_SERVICE_ROLE_KEY) sirf SERVER pe use hote
# hain kabhi browser ko nahi bheje jaate.
# ─────────────────────────────────────────────────────────────

# Supabase Project URL (public-ish, browser me bhi dekhna allowed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase ANON key — ye browser me jaati hai (ye security source nahi hai,
# security RLS policies se aati hai). Isse public hi rehne dena.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase SERVICE ROLE key — SIRF SERVER SIDE. YE KABHI FRONTEND ME NAHI JAATI.
# Iski help se admin kisi bhi row ko RLS bypass karke padh/sakta hai.
# Kahin bhi client (NEXT_PUBLIC_*) prefix na lagao.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bootstrap admin emails — comma separated.
# JB ye rajono ke banaye, in emails ke user ko pehle login pe role=admin milta hai.
ADMIN_EMAILS=you@westcrestmedia.in

# Site URL — OAuth redirect ke liye
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production chala rahe ho to ise change karo:
# NEXT_PUBLIC_SITE_URL=https://admin.westcrestmedia.in